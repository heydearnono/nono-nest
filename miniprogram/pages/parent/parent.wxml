<!-- 家长端：蒙层与家长首页是同一页的两个状态（unlocked 是页面字段，不落盘） -->
<view class="parent" wx:if="{{state}}">
  <!-- 状态一：PIN 蒙层。冷却中输入框禁用，倒计时在 hint 里 -->
  <view class="gate" wx:if="{{!unlocked}}">
    <view class="gate__icon">🔒</view>
    <view class="gate__title">家长验证</view>
    <view class="gate__tip">输入 4 位密码</view>

    <input
      class="gate__input"
      type="number"
      password
      maxlength="4"
      value="{{input}}"
      disabled="{{state.locked}}"
      placeholder="••••"
      bindinput="onInputPin"
    />

    <view class="gate__err" wx:if="{{hint}}">{{hint}}</view>

    <button
      class="gate__btn"
      disabled="{{state.locked || input.length !== 4}}"
      bindtap="onTapUnlock"
    >
      进去
    </button>
  </view>

  <!-- 状态二：家长首页。设置 / 任务 / 数据三段，第三段的看板 / 报告 / 审批不在本轮 -->
  <block wx:else>
    <!-- 三段切换只多一个 tab 字段（不新开页面，见 doc.md） -->
    <view class="tabs">
      <view
        class="tabs__item {{tab === 'settings' ? 'tabs__item--on' : ''}}"
        data-tab="settings"
        bindtap="onTapTab"
      >
        设置
      </view>
      <view
        class="tabs__item {{tab === 'tasks' ? 'tabs__item--on' : ''}}"
        data-tab="tasks"
        bindtap="onTapTab"
      >
        任务
      </view>
      <view
        class="tabs__item {{tab === 'data' ? 'tabs__item--on' : ''}}"
        data-tab="data"
        bindtap="onTapTab"
      >
        数据
      </view>
    </view>

    <view class="sec" wx:if="{{tab === 'settings'}}">
      <view class="sec__title">设置</view>

      <view class="field">
        <view class="field__label">孩子昵称</view>
        <input
          class="field__input"
          maxlength="12"
          value="{{form.childName}}"
          data-field="childName"
          bindinput="onInputField"
        />
      </view>

      <view class="field">
        <view class="field__label">家长密码</view>
        <input
          class="field__input"
          type="number"
          maxlength="4"
          value="{{form.pin}}"
          data-field="pin"
          bindinput="onInputField"
        />
      </view>

      <view class="field">
        <view class="field__label">每日目标（1~12 项）</view>
        <input
          class="field__input"
          type="number"
          maxlength="2"
          value="{{form.dailyGoal}}"
          data-field="dailyGoal"
          bindinput="onInputField"
        />
      </view>

      <view class="field">
        <view class="field__label">备注（只在这里显示）</view>
        <textarea
          class="field__area"
          maxlength="200"
          value="{{form.note}}"
          data-field="note"
          bindinput="onInputField"
        />
      </view>

      <button class="save" bindtap="onTapSave">保存</button>
    </view>

    <!-- 任务段：18 行 + 新增 + 三张兑换卡。列全部（含停用的），否则关掉就开不回来 -->
    <view class="sec" wx:if="{{tab === 'tasks'}}">
      <view class="sec__title">任务</view>

      <!-- coreWarn 是提示不是门禁：家长看得见后果，仍然可以那么做 -->
      <view class="warn" wx:if="{{coreWarnText}}">{{coreWarnText}}</view>
      <view class="sec__now">计入今日全勤的有 {{tasks.coreCount}} 项</view>

      <view class="task" wx:for="{{tasks.habits}}" wx:key="id">
        <view class="task__row">
          <view class="task__icon">{{item.icon}}</view>
          <view class="task__name {{item.enabled ? '' : 'task__name--off'}}">{{item.name}}</view>

          <!-- 上移 / 下移只在同类内移动，按钮按 first / last 置灰（utils 给的） -->
          <view
            class="task__move {{item.first ? 'task__move--off' : ''}}"
            data-id="{{item.id}}"
            data-delta="-1"
            bindtap="onTapMove"
          >
            ↑
          </view>
          <view
            class="task__move {{item.last ? 'task__move--off' : ''}}"
            data-id="{{item.id}}"
            data-delta="1"
            bindtap="onTapMove"
          >
            ↓
          </view>

          <switch
            class="task__switch"
            checked="{{item.enabled}}"
            data-id="{{item.id}}"
            bindchange="onToggleEnabled"
          />
          <view class="task__more" data-id="{{item.id}}" bindtap="onTapExpand">
            {{editing === item.id ? '收起' : '编辑'}}
          </view>
        </view>

        <view class="edit" wx:if="{{editing === item.id}}">
          <!-- 名字与图标只有 habit 类能改：另两类的显示名在别处定义（editable 由 utils 算） -->
          <view class="edit__field">
            <view class="edit__label">名字</view>
            <input
              class="edit__input"
              maxlength="12"
              disabled="{{!item.editable}}"
              value="{{edit.name}}"
              data-field="name"
              bindinput="onInputEdit"
            />
          </view>
          <view class="edit__field">
            <view class="edit__label">图标</view>
            <input
              class="edit__input"
              maxlength="2"
              disabled="{{!item.editable}}"
              value="{{edit.icon}}"
              data-field="icon"
              bindinput="onInputEdit"
            />
          </view>
          <view class="edit__tip" wx:if="{{!item.editable}}">
            这一类的名字与图标由学习 / 健康页定义，改了两处会不一致。
          </view>

          <view class="edit__field">
            <view class="edit__label">⭐ 星光（0~10）</view>
            <input
              class="edit__input"
              type="number"
              maxlength="2"
              value="{{edit.starReward}}"
              data-field="starReward"
              bindinput="onInputEdit"
            />
          </view>
          <view class="edit__field">
            <view class="edit__label">🍖 宠物粮（0~10）</view>
            <input
              class="edit__input"
              type="number"
              maxlength="2"
              value="{{edit.petFoodReward}}"
              data-field="petFoodReward"
              bindinput="onInputEdit"
            />
          </view>

          <view class="edit__field edit__field--row">
            <view class="edit__label">计入今日全勤</view>
            <switch checked="{{item.core}}" data-id="{{item.id}}" bindchange="onToggleCore" />
          </view>

          <button class="act" bindtap="onTapSaveHabit">保存这一条</button>
        </view>
      </view>

      <!-- 新增只能加 habit 类：另两类加完没有页面能打上这一卡（doc.md 缺陷 9） -->
      <view class="add">
        <view class="add__label">加一条自律任务（只能加首页那九格那一类）</view>
        <input
          class="add__input"
          maxlength="12"
          placeholder="任务名字"
          value="{{adding.name}}"
          data-field="name"
          bindinput="onInputAdd"
        />
        <input
          class="add__input add__input--icon"
          maxlength="2"
          placeholder="图标（默认 ⭐）"
          value="{{adding.icon}}"
          data-field="icon"
          bindinput="onInputAdd"
        />
        <button class="act" bindtap="onTapAddHabit">加一条</button>
        <view class="add__tip">加错了可以停用 —— 任务不能删（历史打卡按 id 存）。</view>
      </view>

      <!-- 三张卡全都列（含停用的），家长只能开关，改价不做 -->
      <view class="cards">
        <view class="cards__label">兑换卡</view>
        <view class="card" wx:for="{{tasks.rewards}}" wx:key="id">
          <view class="card__icon">{{item.icon}}</view>
          <view class="card__name {{item.enabled ? '' : 'card__name--off'}}">{{item.name}}</view>
          <view class="card__cost">{{item.medalCost}}🏅</view>
          <switch checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="onToggleReward" />
        </view>
      </view>
    </view>

    <view class="sec" wx:if="{{tab === 'data'}}">
      <view class="sec__title">数据</view>
      <view class="sec__now"
        >这台机器上：{{state.summary.days}} 天记录 · {{state.summary.chars}} 字 ·
        {{state.summary.poems}} 首 · {{state.summary.rounds}} 道题</view
      >

      <button class="act" bindtap="onTapExport">复制存档到剪贴板</button>

      <view class="imp">
        <view class="imp__label">从线上工作台导入（整份覆盖）</view>
        <textarea
          class="imp__area"
          value="{{pasted}}"
          placeholder="把导出的 JSON 粘在这里"
          bindinput="onInputPaste"
        />
        <button class="act" bindtap="onTapPreview">看看这份数据</button>

        <!-- 摘要是覆盖前唯一能区分「粘对了」与「粘了别的」的东西 -->
        <view class="prev" wx:if="{{preview}}">
          <view class="prev__line"
            >这份数据里：{{preview.days}} 天记录 · {{preview.chars}} 字 · {{preview.poems}} 首 ·
            {{preview.rounds}} 道题</view
          >
          <view class="prev__line prev__line--sub">⭐ {{preview.star}} · 🏅 {{preview.medal}}</view>
          <button class="act act--warn" bindtap="onTapImport">确认覆盖</button>
        </view>
      </view>

      <!-- 清空与上面两个不同样式：灰的、在最下面（doc.md 缺陷 5） -->
      <view class="reset" bindtap="onTapReset">清空所有数据</view>
    </view>
  </block>
</view>
