.home {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.home__title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.home__hint {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.7;
}

.home__egg {
  margin-top: 64rpx;
  font-size: 160rpx;
}
