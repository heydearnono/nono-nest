<!-- 首页：问候语 + 今日进度 + 九个打卡格子。不读长句就能用（vision.md「什么算好」第 3 条） -->
<view class="home">
  <view class="home__greeting">{{greeting}}</view>

  <view class="home__stat">
    <view class="home__progress">{{done}} / {{total}}</view>
    <view class="home__streak" wx:if="{{streak > 0}}">🔥 连续 {{streak}} 天</view>
    <view class="home__streak home__streak--zero" wx:else>今天还没开始</view>
  </view>

  <!-- 货币带：只显示打卡能产出的两种。宝石与勋章恒为 0，显示了是噪音 -->
  <view class="purse">
    <view class="purse__item">⭐ {{star}}</view>
    <view class="purse__item">🍖 {{petFood}}</view>
  </view>

  <view class="grid">
    <view
      class="cell {{item.checked ? 'cell--done' : ''}}"
      wx:for="{{items}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapHabit"
      hover-class="cell--hover"
    >
      <view class="cell__icon">{{item.icon}}</view>
      <view class="cell__name">{{item.name}}</view>
      <view class="cell__check" wx:if="{{item.checked}}">✓</view>
    </view>
  </view>
</view>
